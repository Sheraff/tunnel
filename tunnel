#!/usr/bin/env zsh

emulate -R zsh
setopt no_nomatch

PROGRAM=${0:t}

die() {
  print -u2 -r -- "$PROGRAM: $*"
  exit 1
}

usage_error() {
  print -u2 -r -- "$PROGRAM: $*"
  print -u2 -r -- "Run '$PROGRAM help' for usage."
  exit 2
}

usage() {
  print -r -- "Usage:"
  print -r -- "  $PROGRAM list"
  print -r -- "  $PROGRAM status"
  print -r -- "  $PROGRAM open HOST:PORT"
  print -r -- "  $PROGRAM open HOST"
  print -r -- "  $PROGRAM open PORT"
  print -r -- "  $PROGRAM open"
  print -r -- "  $PROGRAM reopen PORT"
  print -r -- "  $PROGRAM reopen all"
  print -r -- "  $PROGRAM reopen"
  print -r -- "  $PROGRAM close PORT"
  print -r -- "  $PROGRAM close all"
  print -r -- "  $PROGRAM close"
  print -r -- "  $PROGRAM prune"
}

require_command() {
  emulate -L zsh
  local name="$1"
  command -v "$name" >/dev/null 2>&1 || die "$name is required"
}

runtime_dir() {
  emulate -L zsh
  local user_name="${USER:-$(id -un)}"
  print -r -- "${XDG_RUNTIME_DIR:-/tmp}/tunnel-$user_name"
}

ensure_runtime_dir() {
  emulate -L zsh
  local dir
  dir="$(runtime_dir)"
  mkdir -p -m 700 "$dir" || die "failed to create runtime directory: $dir"
}

safe_name() {
  emulate -L zsh
  local host="$1"
  local port="$2"
  local safe_host="${host//[^A-Za-z0-9_.-]/_}"
  print -r -- "$safe_host-$port"
}

socket_path() {
  emulate -L zsh
  local host="$1"
  local port="$2"
  print -r -- "$(runtime_dir)/$(safe_name "$host" "$port").sock"
}

meta_path() {
  emulate -L zsh
  local host="$1"
  local port="$2"
  print -r -- "$(runtime_dir)/$(safe_name "$host" "$port").meta"
}

validate_port() {
  emulate -L zsh
  local port="$1"

  [[ "$port" == <-> ]] || return 1
  (( port >= 1 && port <= 65535 )) || return 1
  return 0
}

parse_host_port() {
  emulate -L zsh
  local spec="$1"
  local host port

  [[ "$spec" == *:* ]] || usage_error "expected HOST:PORT"
  [[ "$spec" != *:*:* ]] || usage_error "only HOST:PORT syntax is supported"

  host="${spec%%:*}"
  port="${spec#*:}"

  [[ -n "$host" ]] || usage_error "host must not be empty"
  validate_port "$port" || usage_error "port must be numeric and between 1 and 65535"

  PARSED_HOST="$host"
  PARSED_PORT="$port"
}

reset_meta() {
  emulate -L zsh
  META_SSH_HOST=""
  META_LOCAL_PORT=""
  META_REMOTE_HOST=""
  META_REMOTE_PORT=""
  META_SOCKET=""
  META_CREATED_AT=""
}

load_meta() {
  emulate -L zsh
  local file="$1"
  local line key value

  reset_meta
  [[ -r "$file" ]] || return 1

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || continue

    key="${line%%=*}"
    value="${line#*=}"

    case "$key" in
      ssh_host) META_SSH_HOST="$value" ;;
      local_port) META_LOCAL_PORT="$value" ;;
      remote_host) META_REMOTE_HOST="$value" ;;
      remote_port) META_REMOTE_PORT="$value" ;;
      socket) META_SOCKET="$value" ;;
      created_at) META_CREATED_AT="$value" ;;
    esac
  done < "$file"

  [[ -n "$META_SSH_HOST" ]] || return 1
  validate_port "$META_LOCAL_PORT" || return 1
  [[ -n "$META_REMOTE_HOST" ]] || return 1
  validate_port "$META_REMOTE_PORT" || return 1
  [[ -n "$META_SOCKET" ]] || return 1

  return 0
}

write_meta() {
  emulate -L zsh
  local file="$1"
  local ssh_host="$2"
  local local_port="$3"
  local remote_host="$4"
  local remote_port="$5"
  local socket="$6"
  local created_at

  created_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  {
    print -r -- "ssh_host=$ssh_host"
    print -r -- "local_port=$local_port"
    print -r -- "remote_host=$remote_host"
    print -r -- "remote_port=$remote_port"
    print -r -- "socket=$socket"
    print -r -- "created_at=$created_at"
  } > "$file"
}

meta_files() {
  emulate -L zsh
  local dir file
  local -a files
  dir="$(runtime_dir)"
  [[ -d "$dir" ]] || return 0
  files=( "$dir"/*.meta(N) )
  for file in "${files[@]}"; do
    print -r -- "$file"
  done
}

is_control_alive() {
  emulate -L zsh
  local ssh_host="$1"
  local socket="$2"

  [[ -n "$ssh_host" && -n "$socket" ]] || return 1
  ssh -S "$socket" -O check "$ssh_host" >/dev/null 2>&1
}

is_port_listening() {
  emulate -L zsh
  local port="$1"

  command -v lsof >/dev/null 2>&1 || return 2
  lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
}

port_state() {
  emulate -L zsh
  local port="$1"

  if is_port_listening "$port"; then
    print -r -- "listening"
  else
    case $? in
      1) print -r -- "closed" ;;
      2) print -r -- "unknown" ;;
      *) print -r -- "unknown" ;;
    esac
  fi
}

find_meta_by_port() {
  emulate -L zsh
  local port="$1"
  local file

  FOUND_META_FILES=()
  for file in ${(f)"$(meta_files)"}; do
    load_meta "$file" || continue
    [[ "$META_LOCAL_PORT" == "$port" ]] && FOUND_META_FILES+=("$file")
  done
}

list_tunnels() {
  emulate -L zsh
  local file tunnel_state target

  printf "%-6s %-10s %-18s %s\n" "PORT" "SSH HOST" "TARGET" "STATUS"
  for file in ${(f)"$(meta_files)"}; do
    if ! load_meta "$file"; then
      print -u2 -r -- "$PROGRAM: skipping invalid metadata: $file"
      continue
    fi

    if is_control_alive "$META_SSH_HOST" "$META_SOCKET"; then
      tunnel_state="open"
    else
      tunnel_state="stale"
    fi

    target="$META_REMOTE_HOST:$META_REMOTE_PORT"
    printf "%-6s %-10s %-18s %s\n" "$META_LOCAL_PORT" "$META_SSH_HOST" "$target" "$tunnel_state"
  done
}

status_tunnels() {
  emulate -L zsh
  local file control local_port_state tunnel_state target

  printf "%-6s %-10s %-18s %-9s %-10s %s\n" "PORT" "SSH HOST" "TARGET" "CONTROL" "LOCAL PORT" "STATUS"
  for file in ${(f)"$(meta_files)"}; do
    if ! load_meta "$file"; then
      print -u2 -r -- "$PROGRAM: skipping invalid metadata: $file"
      continue
    fi

    if is_control_alive "$META_SSH_HOST" "$META_SOCKET"; then
      control="alive"
    else
      control="dead"
    fi

    local_port_state="$(port_state "$META_LOCAL_PORT")"
    if [[ "$control" == "alive" && "$local_port_state" != "closed" ]]; then
      tunnel_state="open"
    else
      tunnel_state="stale"
    fi

    target="$META_REMOTE_HOST:$META_REMOTE_PORT"
    printf "%-6s %-10s %-18s %-9s %-10s %s\n" "$META_LOCAL_PORT" "$META_SSH_HOST" "$target" "$control" "$local_port_state" "$tunnel_state"
  done
}

try_start_tunnel() {
  emulate -L zsh
  local ssh_host="$1"
  local local_port="$2"
  local remote_host="$3"
  local remote_port="$4"
  local socket="$5"
  local meta="$6"

  START_TUNNEL_ERROR=""

  if ! ssh -fN -M -S "$socket" -o ExitOnForwardFailure=yes -L "$local_port:$remote_host:$remote_port" "$ssh_host"; then
    START_TUNNEL_ERROR="failed to open tunnel $ssh_host:$local_port"
    return 1
  fi

  if ! write_meta "$meta" "$ssh_host" "$local_port" "$remote_host" "$remote_port" "$socket"; then
    ssh -S "$socket" -O exit "$ssh_host" >/dev/null 2>&1
    START_TUNNEL_ERROR="opened tunnel but failed to write metadata: $meta"
    return 1
  fi
}

start_tunnel() {
  emulate -L zsh
  try_start_tunnel "$@" || die "$START_TUNNEL_ERROR"
}

open_tunnel() {
  emulate -L zsh
  local spec="$1"
  local ssh_host local_port remote_host remote_port socket meta file stale_count alive_count

  parse_host_port "$spec"
  ssh_host="$PARSED_HOST"
  local_port="$PARSED_PORT"
  remote_host="localhost"
  remote_port="$local_port"

  ensure_runtime_dir
  socket="$(socket_path "$ssh_host" "$local_port")"
  meta="$(meta_path "$ssh_host" "$local_port")"

  find_meta_by_port "$local_port"
  stale_count=0
  alive_count=0
  for file in "${FOUND_META_FILES[@]}"; do
    load_meta "$file" || continue
    if is_control_alive "$META_SSH_HOST" "$META_SOCKET"; then
      (( alive_count++ ))
    else
      (( stale_count++ ))
    fi
  done

  (( alive_count == 0 )) || die "local port $local_port is already used by a managed tunnel"
  (( stale_count == 0 )) || die "stale metadata exists for local port $local_port; run '$PROGRAM reopen $local_port' to reopen it or '$PROGRAM prune' to remove it"

  if [[ -e "$meta" || -e "$socket" ]]; then
    die "metadata or socket already exists for $ssh_host:$local_port; run '$PROGRAM prune' if it is stale"
  fi

  if is_port_listening "$local_port"; then
    die "local port $local_port is already listening"
  fi

  start_tunnel "$ssh_host" "$local_port" "$remote_host" "$remote_port" "$socket" "$meta"
  print -r -- "Opened $local_port -> $ssh_host:$remote_host:$remote_port"
}

reopen_meta_file() {
  emulate -L zsh
  local file="$1"
  local ssh_host local_port remote_host remote_port socket

  load_meta "$file" || die "invalid metadata: $file"
  ssh_host="$META_SSH_HOST"
  local_port="$META_LOCAL_PORT"
  remote_host="$META_REMOTE_HOST"
  remote_port="$META_REMOTE_PORT"
  socket="$META_SOCKET"

  if is_control_alive "$ssh_host" "$socket"; then
    die "managed tunnel on local port $local_port is already open"
  fi

  if is_port_listening "$local_port"; then
    die "local port $local_port is already listening"
  fi

  reopen_tunnel_record "$file" "$ssh_host" "$local_port" "$remote_host" "$remote_port" "$socket" || die "$START_TUNNEL_ERROR"
}

reopen_tunnel_record() {
  emulate -L zsh
  local file="$1"
  local ssh_host="$2"
  local local_port="$3"
  local remote_host="$4"
  local remote_port="$5"
  local socket="$6"

  rm -f "$socket"
  try_start_tunnel "$ssh_host" "$local_port" "$remote_host" "$remote_port" "$socket" "$file" || return 1
  print -r -- "Reopened $local_port -> $ssh_host:$remote_host:$remote_port"
}

reopen_all_tunnels() {
  emulate -L zsh
  local file ssh_host local_port remote_host remote_port socket
  local reopened skipped failed

  reopened=0
  skipped=0
  failed=0

  for file in ${(f)"$(meta_files)"}; do
    if ! load_meta "$file"; then
      print -u2 -r -- "$PROGRAM: skipping invalid metadata: $file"
      (( skipped++ ))
      continue
    fi

    ssh_host="$META_SSH_HOST"
    local_port="$META_LOCAL_PORT"
    remote_host="$META_REMOTE_HOST"
    remote_port="$META_REMOTE_PORT"
    socket="$META_SOCKET"

    if is_control_alive "$ssh_host" "$socket"; then
      (( skipped++ ))
      continue
    fi

    if is_port_listening "$local_port"; then
      print -u2 -r -- "$PROGRAM: cannot reopen tunnel on local port $local_port: local port is already listening"
      (( failed++ ))
      continue
    fi

    if ! reopen_tunnel_record "$file" "$ssh_host" "$local_port" "$remote_host" "$remote_port" "$socket"; then
      print -u2 -r -- "$PROGRAM: $START_TUNNEL_ERROR"
      (( failed++ ))
      continue
    fi

    (( reopened++ ))
  done

  printf "Reopened %d stale tunnel(s); skipped %d tunnel(s); failed %d tunnel(s).\n" "$reopened" "$skipped" "$failed"
  (( failed == 0 ))
}

reopen_tunnel_by_port() {
  emulate -L zsh
  local port="$1"

  validate_port "$port" || usage_error "port must be numeric and between 1 and 65535"

  find_meta_by_port "$port"
  case ${#FOUND_META_FILES[@]} in
    0) die "no managed tunnel uses local port $port" ;;
    1) reopen_meta_file "${FOUND_META_FILES[1]}" ;;
    *) die "multiple managed tunnels use local port $port; run '$PROGRAM reopen' and choose one" ;;
  esac
}

close_meta_file() {
  emulate -L zsh
  local file="$1"
  local ssh_host local_port remote_host remote_port socket

  load_meta "$file" || die "invalid metadata: $file"

  ssh_host="$META_SSH_HOST"
  local_port="$META_LOCAL_PORT"
  remote_host="$META_REMOTE_HOST"
  remote_port="$META_REMOTE_PORT"
  socket="$META_SOCKET"

  if ! is_control_alive "$ssh_host" "$socket"; then
    die "managed tunnel on local port $local_port is not alive; run '$PROGRAM reopen $local_port' to reopen it or '$PROGRAM prune' to remove it"
  fi

  close_tunnel_record "$file" "$ssh_host" "$local_port" "$remote_host" "$remote_port" "$socket" || die "$CLOSE_TUNNEL_ERROR"
}

close_tunnel_record() {
  emulate -L zsh
  local file="$1"
  local ssh_host="$2"
  local local_port="$3"
  local remote_host="$4"
  local remote_port="$5"
  local socket="$6"

  CLOSE_TUNNEL_ERROR=""

  if ! ssh -S "$socket" -O exit "$ssh_host" >/dev/null 2>&1; then
    CLOSE_TUNNEL_ERROR="failed to close tunnel on local port $local_port"
    return 1
  fi

  rm -f "$file" "$socket"
  print -r -- "Closed $local_port -> $ssh_host:$remote_host:$remote_port"
}

close_all_tunnels() {
  emulate -L zsh
  local file ssh_host local_port remote_host remote_port socket
  local closed skipped failed

  closed=0
  skipped=0
  failed=0

  for file in ${(f)"$(meta_files)"}; do
    if ! load_meta "$file"; then
      print -u2 -r -- "$PROGRAM: skipping invalid metadata: $file"
      (( skipped++ ))
      continue
    fi

    ssh_host="$META_SSH_HOST"
    local_port="$META_LOCAL_PORT"
    remote_host="$META_REMOTE_HOST"
    remote_port="$META_REMOTE_PORT"
    socket="$META_SOCKET"

    if ! is_control_alive "$ssh_host" "$socket"; then
      (( skipped++ ))
      continue
    fi

    if ! close_tunnel_record "$file" "$ssh_host" "$local_port" "$remote_host" "$remote_port" "$socket"; then
      print -u2 -r -- "$PROGRAM: $CLOSE_TUNNEL_ERROR"
      (( failed++ ))
      continue
    fi

    (( closed++ ))
  done

  printf "Closed %d live tunnel(s); skipped %d tunnel(s); failed %d tunnel(s).\n" "$closed" "$skipped" "$failed"
  (( failed == 0 ))
}

close_tunnel_by_port() {
  emulate -L zsh
  local port="$1"

  validate_port "$port" || usage_error "port must be numeric and between 1 and 65535"

  find_meta_by_port "$port"
  case ${#FOUND_META_FILES[@]} in
    0) die "no managed tunnel uses local port $port" ;;
    1) close_meta_file "${FOUND_META_FILES[1]}" ;;
    *) die "multiple managed tunnels use local port $port; run '$PROGRAM close' and choose one" ;;
  esac
}

can_use_arrow_menu() {
  emulate -L zsh
  [[ -t 0 && -t 1 && "${TERM:-dumb}" != "dumb" ]]
}

render_arrow_menu() {
  emulate -L zsh
  local selected="$1"
  local prompt="$2"
  local item i
  local -a items

  shift 2
  items=( "$@" )

  print -r -- "$prompt"
  for (( i = 1; i <= ${#items[@]}; i++ )); do
    item="${items[i]}"
    if (( i == selected )); then
      print -r -- "  > $item"
    else
      print -r -- "    $item"
    fi
  done
  print -n -r -- "Use Up/Down and Enter (Esc to cancel)"
}

select_menu() {
  emulate -L zsh
  local prompt="$1"
  local choice selected key next direction i
  local -a items

  shift
  items=( "$@" )
  (( ${#items[@]} > 0 )) || return 1

  if ! can_use_arrow_menu; then
    for (( i = 1; i <= ${#items[@]}; i++ )); do
      print -r -- "  $i) ${items[i]}"
    done
    print -r -- ""
    read "choice?$prompt " || return 1

    [[ "$choice" == <-> ]] || usage_error "selection must be numeric"
    (( choice >= 1 && choice <= ${#items[@]} )) || usage_error "selection out of range"
    SELECTED_INDEX="$choice"
    return 0
  fi

  selected=1
  render_arrow_menu "$selected" "$prompt" "${items[@]}"

  while true; do
    if ! read -rsk 1 key; then
      print -r -- ""
      return 1
    fi

    case "$key" in
      $'\r'|$'\n')
        print -r -- ""
        SELECTED_INDEX="$selected"
        return 0
        ;;
      $'\e')
        if ! read -rsk 1 -t 0.2 next; then
          print -r -- ""
          return 1
        fi
        [[ "$next" == "[" || "$next" == "O" ]] || continue
        read -rsk 1 -t 0.2 direction || continue
        case "$direction" in
          A)
            if (( selected == 1 )); then
              selected=${#items[@]}
            else
              (( selected-- ))
            fi
            ;;
          B)
            if (( selected == ${#items[@]} )); then
              selected=1
            else
              (( selected++ ))
            fi
            ;;
          *) continue ;;
        esac
        printf "\r\033[%dA" $(( ${#items[@]} + 1 ))
        render_arrow_menu "$selected" "$prompt" "${items[@]}"
        ;;
    esac
  done
}

known_ssh_hosts() {
  emulate -L zsh
  local config="$HOME/.ssh/config"
  local line host i
  local -a parts
  local -A seen

  [[ -r "$config" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    parts=( ${(z)line} )
    (( ${#parts[@]} >= 2 )) || continue
    [[ "${parts[1]}" == "Host" ]] || continue

    for (( i = 2; i <= ${#parts[@]}; i++ )); do
      host="${parts[i]}"
      [[ "$host" == *[\*\?]* ]] && continue
      [[ -n "${seen[$host]}" ]] && continue
      seen[$host]=1
      print -r -- "$host"
    done
  done < "$config"
}

select_ssh_host() {
  emulate -L zsh
  local ssh_host i
  local -a hosts choices

  hosts=( ${(f)"$(known_ssh_hosts)"} )
  if ! can_use_arrow_menu; then
    if (( ${#hosts[@]} > 0 )); then
      print -r -- "Known SSH hosts:"
      for (( i = 1; i <= ${#hosts[@]}; i++ )); do
        print -r -- "  $i) ${hosts[i]}"
      done
      print -r -- ""
    fi

    read "ssh_host?SSH host: " || exit 1
    [[ -n "$ssh_host" ]] || usage_error "host must not be empty"

    if [[ "$ssh_host" == <-> ]]; then
      (( ssh_host >= 1 && ssh_host <= ${#hosts[@]} )) || usage_error "host selection out of range"
      ssh_host="${hosts[$ssh_host]}"
    fi

    SELECTED_SSH_HOST="$ssh_host"
    return 0
  fi

  if (( ${#hosts[@]} == 0 )); then
    read "ssh_host?SSH host: " || exit 1
  else
    choices=( "${hosts[@]}" "Enter another host..." )
    select_menu "SSH host:" "${choices[@]}" || exit 1
    if (( SELECTED_INDEX <= ${#hosts[@]} )); then
      ssh_host="${hosts[$SELECTED_INDEX]}"
    else
      read "ssh_host?SSH host: " || exit 1
    fi
  fi

  [[ -n "$ssh_host" ]] || usage_error "host must not be empty"
  SELECTED_SSH_HOST="$ssh_host"
}

normalize_listener_endpoint() {
  emulate -L zsh
  local endpoint="$1"
  local format="$2"
  local address port

  NORMALIZED_LISTENER_PORT=""

  if [[ "$format" == "netstat" && "$endpoint" == *.<-> ]]; then
    port="${endpoint##*.}"
    address="${endpoint%.*}"
  else
    [[ "$endpoint" == *:* ]] || return 1
    port="${endpoint##*:}"
    address="${endpoint%:*}"
  fi

  address="${address#\[}"
  address="${address%\]}"
  validate_port "$port" || return 1

  case "$address" in
    "*"|"0.0.0.0"|"127.0.0.1"|"::"|"::1") ;;
    *) return 1 ;;
  esac

  NORMALIZED_LISTENER_PORT="$port"
}

discover_remote_ports() {
  emulate -L zsh
  local ssh_host="$1"
  local output ssh_status line provider endpoint port
  local remote_command
  local -a parts ports
  local -A seen

  remote_command='LC_ALL=C
export LC_ALL
if command -v ss >/dev/null 2>&1; then
  printf "__TUNNEL_SS__\n"
  ss -lnt 2>/dev/null
  exit 0
fi
if command -v lsof >/dev/null 2>&1; then
  printf "__TUNNEL_LSOF__\n"
  lsof -nP -a -iTCP -sTCP:LISTEN -Fn 2>/dev/null
  exit 0
fi
if command -v netstat >/dev/null 2>&1; then
  printf "__TUNNEL_NETSTAT__\n"
  netstat -an 2>/dev/null
  exit 0
fi
exit 64'

  output="$(ssh "$ssh_host" "$remote_command")"
  ssh_status=$?
  case "$ssh_status" in
    0) ;;
    64) die "cannot discover ports on $ssh_host: remote host requires ss, lsof, or netstat" ;;
    *) die "failed to discover ports on $ssh_host" ;;
  esac

  provider=""
  ports=()
  for line in ${(f)output}; do
    case "$line" in
      "__TUNNEL_SS__") provider="ss"; continue ;;
      "__TUNNEL_LSOF__") provider="lsof"; continue ;;
      "__TUNNEL_NETSTAT__") provider="netstat"; continue ;;
    esac

    [[ -n "$provider" ]] || continue
    case "$provider" in
      ss)
        parts=( ${(z)line} )
        (( ${#parts[@]} >= 4 )) || continue
        endpoint="${parts[4]}"
        ;;
      lsof)
        [[ "$line" == n* ]] || continue
        endpoint="${line#n}"
        ;;
      netstat)
        [[ "$line" == *LISTEN* ]] || continue
        parts=( ${(z)line} )
        (( ${#parts[@]} >= 4 )) || continue
        endpoint="${parts[4]}"
        ;;
    esac

    normalize_listener_endpoint "$endpoint" "$provider" || continue
    port="$NORMALIZED_LISTENER_PORT"
    [[ -n "${seen[$port]}" ]] && continue
    seen[$port]=1
    ports+=("$port")
  done

  [[ -n "$provider" ]] || die "received an invalid port discovery response from $ssh_host"
  (( ${#ports[@]} > 0 )) || die "no loopback or wildcard TCP listeners found on $ssh_host"
  DISCOVERED_PORTS=( ${(on)ports} )
}

interactive_open_host() {
  emulate -L zsh
  local ssh_host="$1"
  local local_port
  local -a choices

  [[ -n "$ssh_host" ]] || usage_error "host must not be empty"
  discover_remote_ports "$ssh_host"

  print -r -- "Listening TCP ports on $ssh_host:"
  choices=( "${DISCOVERED_PORTS[@]}" "Enter another port..." )
  select_menu "Open which port?" "${choices[@]}" || exit 1

  if (( SELECTED_INDEX <= ${#DISCOVERED_PORTS[@]} )); then
    local_port="${DISCOVERED_PORTS[$SELECTED_INDEX]}"
  else
    read "local_port?Port: " || exit 1
    validate_port "$local_port" || usage_error "port must be numeric and between 1 and 65535"
  fi

  open_tunnel "$ssh_host:$local_port"
}

interactive_open_port() {
  emulate -L zsh
  local local_port="$1"

  validate_port "$local_port" || usage_error "port must be numeric and between 1 and 65535"
  select_ssh_host
  open_tunnel "$SELECTED_SSH_HOST:$local_port"
}

interactive_open() {
  emulate -L zsh

  select_ssh_host
  interactive_open_host "$SELECTED_SSH_HOST"
}

interactive_close() {
  emulate -L zsh
  local file label
  local -a files labels

  files=()
  labels=()
  for file in ${(f)"$(meta_files)"}; do
    load_meta "$file" || continue
    files+=("$file")
    printf -v label "%-6s %s -> %s:%s" "$META_SSH_HOST" "$META_LOCAL_PORT" "$META_REMOTE_HOST" "$META_REMOTE_PORT"
    labels+=("$label")
  done

  (( ${#files[@]} > 0 )) || die "no managed tunnels to close"
  select_menu "Close which tunnel?" "${labels[@]}" || exit 1

  close_meta_file "${files[$SELECTED_INDEX]}"
}

interactive_reopen() {
  emulate -L zsh
  local file label
  local -a files labels

  files=()
  labels=()
  for file in ${(f)"$(meta_files)"}; do
    load_meta "$file" || continue
    is_control_alive "$META_SSH_HOST" "$META_SOCKET" && continue
    files+=("$file")
    printf -v label "%-6s %s -> %s:%s" "$META_SSH_HOST" "$META_LOCAL_PORT" "$META_REMOTE_HOST" "$META_REMOTE_PORT"
    labels+=("$label")
  done

  (( ${#files[@]} > 0 )) || die "no stale managed tunnels to reopen"
  select_menu "Reopen which tunnel?" "${labels[@]}" || exit 1

  reopen_meta_file "${files[$SELECTED_INDEX]}"
}

prune_tunnels() {
  emulate -L zsh
  local file pruned kept socket

  pruned=0
  kept=0

  for file in ${(f)"$(meta_files)"}; do
    if ! load_meta "$file"; then
      rm -f "$file" "${file:r}.sock"
      (( pruned++ ))
      continue
    fi

    socket="$META_SOCKET"
    if is_control_alive "$META_SSH_HOST" "$socket"; then
      (( kept++ ))
      continue
    fi

    rm -f "$file" "$socket"
    (( pruned++ ))
  done

  printf "Pruned %d stale tunnel(s); kept %d live tunnel(s).\n" "$pruned" "$kept"
}

main() {
  emulate -L zsh
  local command_name="${1:-}"

  [[ -n "$command_name" ]] || usage_error "missing command"
  shift

  case "$command_name" in
    help|-h|--help)
      (( $# == 0 )) || usage_error "too many arguments"
      usage
      ;;
    list)
      (( $# == 0 )) || usage_error "list takes no arguments"
      require_command ssh
      list_tunnels
      ;;
    status)
      (( $# == 0 )) || usage_error "status takes no arguments"
      require_command ssh
      status_tunnels
      ;;
    open)
      require_command ssh
      case $# in
        0) interactive_open ;;
        1)
          if [[ "$1" == *:* ]]; then
            open_tunnel "$1"
          elif [[ "$1" == <-> ]]; then
            interactive_open_port "$1"
          else
            interactive_open_host "$1"
          fi
          ;;
        *) usage_error "open takes zero or one argument" ;;
      esac
      ;;
    reopen)
      require_command ssh
      case $# in
        0) interactive_reopen ;;
        1)
          if [[ "$1" == "all" ]]; then
            reopen_all_tunnels
          else
            reopen_tunnel_by_port "$1"
          fi
          ;;
        *) usage_error "reopen takes zero or one argument" ;;
      esac
      ;;
    close)
      require_command ssh
      case $# in
        0) interactive_close ;;
        1)
          if [[ "$1" == "all" ]]; then
            close_all_tunnels
          else
            close_tunnel_by_port "$1"
          fi
          ;;
        *) usage_error "close takes zero or one argument" ;;
      esac
      ;;
    prune)
      (( $# == 0 )) || usage_error "prune takes no arguments"
      require_command ssh
      prune_tunnels
      ;;
    *)
      usage_error "unknown command: $command_name"
      ;;
  esac
}

main "$@"
